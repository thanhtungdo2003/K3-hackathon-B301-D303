# Sao chép thành .env — KHÔNG commit file .env

# ── LLM: Groq ────────────────────────────────────────────────────────────
# Lấy khoá tại https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Đặt 0 để chạy hoàn toàn bằng luật (không gọi LLM)
AGORA_AI_ENABLED=1

# ── Ứng dụng ─────────────────────────────────────────────────────────────
# Bắt buộc đổi khi triển khai thật
AGORA_JWT_SECRET=doi-chuoi-nay-truoc-khi-trien-khai
AGORA_JWT_HOURS=72

AGORA_DATABASE_URL=sqlite:///./agora.db
AGORA_UPLOAD_DIR=./uploads

# Ngưỡng dữ liệu tối thiểu trước khi Advisor được phép kết luận
AGORA_MIN_RESPONSES=5
AGORA_MIN_PARTICIPATION=0.30
