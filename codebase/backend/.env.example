# Sao chép thành .env — KHÔNG commit file .env

# ── LLM: Groq ────────────────────────────────────────────────────────────
# Lấy khoá tại https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Đặt 0 để chạy hoàn toàn bằng luật (không gọi LLM)
VINLEARN_AI_ENABLED=1

# ── Ứng dụng ─────────────────────────────────────────────────────────────
# Bắt buộc đổi khi triển khai thật
VINLEARN_JWT_SECRET=doi-chuoi-nay-truoc-khi-trien-khai
VINLEARN_JWT_HOURS=72

VINLEARN_DATABASE_URL=sqlite:///./agora.db
VINLEARN_UPLOAD_DIR=./uploads

# Tự kéo học viên về slide giảng viên sau 5 phút lệch liên tục
VINLEARN_SLIDE_SYNC_TIMEOUT_SECONDS=300

# Ngưỡng dữ liệu tối thiểu trước khi Advisor được phép kết luận
VINLEARN_MIN_RESPONSES=5
VINLEARN_MIN_PARTICIPATION=0.30
